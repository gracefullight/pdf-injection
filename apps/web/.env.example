# Base URL for the PDF Injection API. Defaults to "/api" which the Vite dev
# server proxies to VITE_API_PROXY_TARGET (see vite.config.ts), so the browser
# never needs a cross-origin request in local dev.
VITE_API_BASE_URL=/api

# Target the Vite dev server proxies /api to (apps/api's PDFI_PORT default, see apps/api/.env.example).
VITE_API_PROXY_TARGET=http://localhost:3001
