# PDF Injection API — environment variables (all optional, defaults shown)

# Max upload size for the source PDF, in bytes.
PS_MAX_FILE_BYTES=26214400

# Max number of pages a source PDF may have.
PS_MAX_PAGES=100

# Max length (characters) of the hidden instruction.
PS_MAX_INSTRUCTION_CHARS=1500

# Hours a job's artifacts are retained before the sweeper deletes them.
PS_RETENTION_HOURS=24

# Directory where job artifacts (source.pdf, output.pdf, manifest.json,
# report.json) are stored, one subdirectory per jobId.
PS_STORAGE_DIR=./.pdf-injection-data

# Path to the bun:sqlite database file.
PS_DB_PATH=./.pdf-injection-data/pdf-injection.sqlite

# Enable qpdf --check as part of server-side validation. Requires the qpdf
# binary to be installed and on PATH; safely no-ops (qpdfStatus: "not_run")
# when false or when the binary is missing.
PS_QPDF_ENABLED=false

# Max page MediaBox/CropBox dimension (points) before a PDF is rejected as
# structurally abnormal.
PS_MAX_PAGE_DIMENSION_PT=14400

# Allowed CORS origin for the Vite dev server / deployed web app.
PS_CORS_ORIGIN=http://localhost:5173

# How often (ms) the retention sweeper scans for and deletes expired jobs.
PS_SWEEP_INTERVAL_MS=600000

# Port the API listens on when run directly (bun run start / bun run dev).
PS_PORT=3001

# Gate for §3 submissions and §4 robustness research endpoints. Off by
# default: this MVP must not receive real student data.
PS_RESEARCH_MODE=false

# Max A/B/C... variants in a single variant set.
PS_MAX_VARIANTS=8

# Max students in a single student-keyed set.
PS_MAX_STUDENT_KEYS=500

# Max bytes for a single submission upload (txt/md/pdf/image).
PS_MAX_SUBMISSION_BYTES=10485760

# Max submissions stored per job.
PS_MAX_SUBMISSIONS_PER_JOB=500

# Gate for anthropic/openai providers in §2 model-tests and §4 robustness
# text transforms. "mock" is always allowed regardless of this flag. Off by
# default: no PDF/text content leaves this server without an explicit opt-in.
PS_ALLOW_EXTERNAL_PROVIDERS=false

# Anthropic API key. Never sent to the browser; only used server-side when
# PS_ALLOW_EXTERNAL_PROVIDERS=true and a request explicitly selects provider
# "anthropic". Leave unset to use the mock provider only.
ANTHROPIC_API_KEY=

# OpenAI API key. Same gating as ANTHROPIC_API_KEY, for provider "openai".
OPENAI_API_KEY=

# Anthropic model id used by the "anthropic" provider adapter.
PS_ANTHROPIC_MODEL=claude-opus-5

# OpenAI model id used by the "openai" provider adapter.
PS_OPENAI_MODEL=gpt-5.5

# Per-job processing time limit (ms). Exceeding it aborts the request with
# 504 PROCESSING_TIMEOUT and leaves no job row or files behind.
PS_MAX_PROCESSING_MS=60000

# Max `repeats` accepted by POST /jobs/:jobId/model-tests.
PS_MODEL_TEST_MAX_REPEATS=10

# Bounded parallelism for provider calls within a single model-test run.
PS_MODEL_TEST_CONCURRENCY=2

# Directory containing the CJK font subset (Noto Sans KR, OFL) used for
# payloadLanguage="ko". Defaults to packages/pdf-engine/fonts.
PS_FONT_DIR=packages/pdf-engine/fonts

# When set, a completed model-test run's export (JSON) is also copied here.
# Opt-in; unset by default (no copy).
PS_RESEARCH_RESULTS_DIR=
