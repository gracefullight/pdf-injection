#!/bin/bash
#PBS -N pdfi_precision_diag
#PBS -q large_gpuq
#PBS -l select=1:ncpus=4:ngpus=1:mem=96gb:Qlist=large_gpuq
#PBS -l place=shared
#PBS -l walltime=00:20:00
#PBS -j oe
set -euo pipefail
: "${PBS_JOBID:?Submit through PBS}"
cd "${PBS_O_WORKDIR:?}"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false HF_HUB_OFFLINE=1
export PDFI_EXPECTED_VISIBLE_GPUS=1
PDFI_RUN="runs/precision-diagnostic-${PBS_JOBID%%.*}"
PDFI_GPU_UUID=$(.venv/bin/python choose_allocated_gpu.py --record "${PDFI_RUN}-binding.json")
export CUDA_VISIBLE_DEVICES="$PDFI_GPU_UUID"
sha256sum diagnose_precision.py diagnostic_checkpoint.py test_diagnostic_checkpoint.py precision_preflight.py numerical_protocol.py torch_document.py > "${PDFI_RUN}-code.sha256"
.venv/bin/python -m unittest test_diagnostic_checkpoint
exec .venv/bin/python -u diagnose_precision.py --model model --image inputs/document/page-2.png \
    --prompts specification3-prompts.json --failed "${PDFI_FAILED_RUN:?}" --output "$PDFI_RUN"
