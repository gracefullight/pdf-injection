#!/bin/bash
#PBS -N pdfi_gpu_smoke
#PBS -q large_gpuq
#PBS -l select=1:ncpus=2:ngpus=2:mem=8gb
#PBS -l place=excl
#PBS -l walltime=00:05:00
#PBS -j oe

set -euo pipefail
: "${PBS_JOBID:?Submit this script through PBS}"
cd "${PBS_O_WORKDIR:?PBS working directory is required}"
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export PDFI_EXPECTED_VISIBLE_GPUS=2
exec .venv/bin/python -u gpu_smoke.py
